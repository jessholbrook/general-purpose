{{!< default}}

<div class="blog-listing">
    <h1 class="page-heading">Writing</h1>
    <div class="writing-feed">
        {{#foreach posts}}
        <div class="writing-item">
            <h2 class="writing-item-title">
                <a href="{{url}}">{{title}}</a>
            </h2>
            <time class="writing-item-date" datetime="{{date format='YYYY-MM-DD'}}">
                {{date format="MMM D, YYYY"}}
            </time>
        </div>
        {{/foreach}}
    </div>

    {{pagination}}
</div>
